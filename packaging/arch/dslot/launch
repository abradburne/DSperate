#!/bin/sh
# DSlot's game launcher (/usr/lib/dslot/launch ROM), shipped with the dsperate package
# (packaging/arch/dslot in DSperate). DSlot has let go of both panels before this runs and
# takes them back when it returns.
#
# The system is the ROM's folder (Roms/NDS, Roms/GBA, Roms/GB, Roms/GBC, as DSlot's pages are),
# or else its extension (.nds, .gba, .gb, .gbc; a .zip by the file inside it). Each system's
# emulator is a line below, and every one takes the same arguments: --saves DIR --states DIR ROM.
# A game's battery save, its save states and its auto slot (written when Menu is pressed, the
# game resumes from it next time) are kept together in Saves/<SYSTEM>/<ROM name>/ on the ROMS
# partition. DSperate's other settings, controls included, are its own file,
# ~/.config/dsperate/dsperate.ini: the first launch puts the handheld's defaults there
# (/usr/share/dsperate/dslot/dsperate.ini) when there is none, and never overwrites one.
#
# Extra emulator options by system or by game come from ~/.config/dslot/launch.conf (launch.conf
# here is the example the first launch puts there): a line "NDS = --hires3d 2" for every DS game, a line
# "<ROM name without extension> = --hires3d 1" for one game. The game's line goes after its
# system's, so it wins; options there also win over the emulator's own settings and in-game menu.
#
# GBA is DSperate's GBA mode. GB and GBC have no emulator here yet (DSperate's Game Boy mode is
# planned: docs/rk3568/gba-mode.md); a stand-in at /opt/gba-standin is used if one was installed
# by hand, else the launch says so and returns to DSlot.
set -eu
[ $# -eq 1 ] || { echo "usage: launch ROM" >&2; exit 2; }

nds=/usr/bin/dsperate
gba="/usr/bin/dsperate --gba"
gb=/opt/gba-standin/gba-standin
gbc=$gb
share=/usr/share/dsperate/dslot
cfg=${XDG_CONFIG_HOME:-$HOME/.config}
# First launch: the handheld's settings and the options example, where there are none yet.
[ -e "$cfg/dsperate/dsperate.ini" ] || install -Dm644 "$share/dsperate.ini" "$cfg/dsperate/dsperate.ini" 2>/dev/null || true
[ -e "$cfg/dslot/launch.conf" ] || install -Dm644 "$share/launch.conf" "$cfg/dslot/launch.conf" 2>/dev/null || true

rom=$1
name=${rom##*/}
name=${name%.*}
folder=${rom%/*}
folder=${folder##*/}
case "$folder" in
NDS|GBA|GB|GBC) system=$folder ;;
*)
    file=$rom
    case "$rom" in *.[zZ][iI][pP]) file=$(bsdtar -tf "$rom" 2>/dev/null | grep -iE '\.(nds|gba|gbc|gb)$' | head -1) ;; esac
    case "$file" in
    *.[gG][bB][aA]) system=GBA ;;
    *.[gG][bB][cC]) system=GBC ;;
    *.[gG][bB]) system=GB ;;
    *) system=NDS ;;
    esac
    ;;
esac
case "$system" in
NDS) emu=$nds ;;
GBA) emu=$gba ;;
GB) emu=$gb ;;
GBC) emu=$gbc ;;
esac
[ -x "${emu%% *}" ] || { echo "launch: no emulator for $system games here (${emu%% *})" >&2; exit 1; }
# Options from launch.conf: the system's line, then the game's.
conf=$cfg/dslot/launch.conf
sys_opts='' game_opts=''
if [ -r "$conf" ]; then
    while IFS= read -r line; do
        case "$line" in ''|'#'*) continue ;; esac
        key=${line%%=*} val=${line#*=}
        [ "$key" != "$line" ] || continue
        key=$(echo "$key" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
        [ "$key" = "$system" ] && sys_opts="$sys_opts $val"
        [ "$key" = "$name" ] && game_opts="$game_opts $val"
    done < "$conf"
fi
dir=/mnt/roms/Saves/$system/$name
# Without its saves folder (ROMS not mounted, say) the game still starts.
mkdir -p "$dir" || echo "launch: no saves folder $dir" >&2
# KMSDRM straight on the panels. SDL3's atomic KMSDRM path has no plane for the second panel and
# crashes tearing its window down; the legacy path drives both.
export SDL_VIDEODRIVER=kmsdrm SDL_KMSDRM_ATOMIC=0
# Launch stages (the first frame, leaving) stamped in the journal next to DSlot's own marks
# (DS_DEBUG=marks; DS_MARK for dsperate builds from before DS_DEBUG).
export DS_DEBUG=marks DS_MARK=1
# shellcheck disable=SC2086 # the options split into words on purpose
exec $emu $sys_opts $game_opts --saves "$dir" --states "$dir" "$rom"
