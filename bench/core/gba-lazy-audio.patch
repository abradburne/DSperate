diff --git a/src/core/gba/gba.h b/src/core/gba/gba.h
index f554dff..f170803 100644
--- a/src/core/gba/gba.h
+++ b/src/core/gba/gba.h
@@ -51,6 +51,8 @@ enum Irq : u16 {
   IRQ_TIMER0 = 1 << 3, IRQ_SERIAL = 1 << 7, IRQ_DMA0 = 1 << 8, IRQ_KEYPAD = 1 << 12, IRQ_GAMEPAK = 1 << 13,
 };
 
+// Audio is no event (Audio::run_to makes the frames lazily); its slot keeps
+// the order of events at the same time and the save-state layout.
 enum class Ev : u8 { Ppu, Timer0, Timer1, Timer2, Timer3, Audio, Irq, Sio, Count };
 // Cycles from an interrupt being raised (IE & IF with IME) to the CPU seeing it.
 constexpr u32 IRQ_DELAY = 7;
@@ -165,6 +167,16 @@ private:
   s32 slice_budget_ = 0;
   u64 slice_end_ = 0;
   bool frame_done_ = false;
+  int firing_ = -1;          // the event being handled (Ev), -1 outside one
+  u64 firing_at_ = 0;        // ... and its time
+  // The sound frames due before what happens now: in the CPU, those up to
+  // now(); in an event's handler, those before it (at its time too for the
+  // events after Audio), as when the frames were an event of their own.
+  void audio_sync() {
+    if (in_cpu_) audio.run_to(now(), true);
+    else if (firing_ >= 0) audio.run_to(firing_at_, firing_ > static_cast<int>(Ev::Audio));
+    else audio.run_to(now_, true);
+  }
 
   // ---- PPU timing ----
   u32 vcount_ = 0;
